# .env は git 管理外。これをコピーして使う: cp .env.example .env

# 必須。未設定のまま起動するとエラー終了する。
DATABASE_URL=postgres://dev:dev@localhost:5432/url_shortener?sslmode=disable
JWT_SECRET=change-me-to-a-random-string

# 任意。未設定なら以下の値が既定で使われる。
# BASE_URL は短縮URLのレスポンスに使う。公開時は実際のドメインを設定する。
# BASE_URL=http://localhost:8080
# PORT=8080
